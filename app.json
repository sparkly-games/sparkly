{
  "expo": {
    "name": "Sparkly Games",
    "slug": "sparklygames",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/favicon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.rilwag2612.onlinegames12"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/favicon.png",
        "backgroundColor": "#818181"
      },
      "edgeToEdgeEnabled": true,
      "package": "dev.sparkly.games"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-router",
        {
          "origin": "https://sparkly.creepers.sbs"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/favicon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#818181"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
