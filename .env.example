# ------------------------------------------------------------------------------
# SPARKLY GAMES - ENVIRONMENT VARIABLES EXAMPLE
# Copy this file to .env and fill in your private keys.
# ------------------------------------------------------------------------------

# Firebase: Found in Firebase Console > Project Settings
EXPO_PUBLIC_FIREBASE_API_KEY=your_firebase_key_here
EXPO_PUBLIC_USE_ANALYTICS=false

# Statuspage: The embed URL for your status monitoring
EXPO_PUBLIC_USE_STATUSPAGE=true
EXPO_PUBLIC_STATUSPAGE_URL=https://statuspage.statuspage.io/embed/script.js

# Discord: Webhook URL for job application notifications
EXPO_PUBLIC_JOB_WEBHOOK=your_discord_webhook_url

# AI Studio: Get your Gemini API key from https://aistudio.google.com/
EXPO_PUBLIC_GOOGLE_AI_KEY=your_google_ai_key

# UB-Tube: YouTube Data API v3 key & Cobalt instance URL
EXPO_PUBLIC_YT_API_KEY=your_youtube_api_key
EXPO_PUBLIC_COBALT_URL=https://cobalt.mytunnel.eg/